# Copy to .env (never commit .env). Read by docker compose and by backend/app/config.py.

# --- FalkorDB ---
# Pinned image tag. docker compose refuses to start while this is empty.
# 6.x = Rust engine. Fallback: v4.22.0 = C engine (4.x tags carry a "v").
FALKORDB_TAG=6.0.1
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
# Memory cap for every graph on the server (D136). At the cap FalkorDB refuses all writes,
# deletes included; Yaan warns from 80%. ~5.5 KB per item read (`yaan persistence` shows use).
FALKORDB_MAXMEMORY=2gb
# Disk: a snapshot within 60 s of any change. A NEW org deployment can also keep an append-only
# file (at most ~1 s lost in a crash): FALKORDB_APPENDONLY=yes with FALKORDB_SAVE="3600 1". An existing
# volume must switch live first (`yaan persistence aof`): started with AOF over a snapshot-only
# volume, FalkorDB comes up EMPTY.
FALKORDB_SAVE="60 1"
FALKORDB_APPENDONLY=no
LORE_GRAPH=lore_herb
LORE_DEMO_GRAPH=lore_demo
# The graph the API serves (Ask, Inbox, live demo); `lore demo reset` creates it.
LORE_API_GRAPH=lore_demo
# Data mode. demo: the HERB demo company (the default). org: your own tools feed LORE_ORG_GRAPH;
# set it, copy connectors.org.example.yaml over connectors.yaml, list people in people.yaml,
# then run `yaan init` (README: "Use your own data"). The API then serves LORE_ORG_GRAPH.
LORE_DATA_MODE=demo
LORE_ORG_GRAPH=yaan_org
# Sign-in. auto = token in org mode (`yaan token issue "<name>"`), none in the demo. header = a
# sign-in proxy sends the user's email in LORE_AUTH_HEADER and this secret in X-Lore-Proxy-Secret.
LORE_AUTH=auto
LORE_AUTH_HEADER=X-Forwarded-Email
LORE_AUTH_PROXY_SECRET=
# Sign-in with Google, Okta, Entra ID or any OIDC provider: the `sso` compose profile runs
# oauth2-proxy (D133). With LORE_AUTH=header and LORE_AUTH_PROXY_SECRET above, fill these, then
# docker compose --profile app --profile sso up -d (port LORE_SSO_PORT, 4180).
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32 random bytes, base64: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_REDIRECT_URL=http://127.0.0.1:4180/oauth2/callback
OAUTH2_PROXY_EMAIL_DOMAINS=
# Optional: enables POST /ingest/artifact (send it in the X-Lore-Secret header).
LORE_INGEST_SECRET=
# The containers run as this unprivileged user (D108). On Linux, set them to the owner of ./data
# (`id -u`, `id -g`) or `sudo chown -R 10001:10001 data`; Docker Desktop needs neither.
# LORE_UID=10001
# LORE_GID=10001
QUERY_TIMEOUT_MS=2000
# Redis ACL users (Phase 1.4, D018). docker compose creates them at start; app/db.py logs in with them.
# The placeholders work for a local run (ports are bound to 127.0.0.1). Replace them before any
# deployment, e.g. with: python -c "import secrets; print(secrets.token_hex(16))"
# Letters, digits and dashes only: the image's start script splits these on spaces and globs.
# The Browser (http://localhost:3000) logs in as user "default" with the admin password.
FALKORDB_ADMIN_PASSWORD=lore-admin-local
FALKORDB_WRITER_USER=lore_writer
FALKORDB_WRITER_PASSWORD=lore-writer-local
FALKORDB_READER_USER=lore_reader
FALKORDB_READER_PASSWORD=lore-reader-local

# --- LLM (Anthropic) ---
# Needed for answers (Phase 4+) and extraction (Phase 7). Rebuilding the graph from a seed needs no key.
# Prepaid credits with auto-reload off are a hard cap; llm.py also refuses any call that could take
# today's spend over LORE_DAILY_SPEND_CAP_USD (D033). Check the key with: lore llm-check
ANTHROPIC_API_KEY=
LORE_EXTRACT_MODEL=claude-haiku-5-5
LORE_ANSWER_MODEL=claude-haiku-5-5
LORE_EXTRACT_EFFORT=low
LORE_ANSWER_EFFORT=medium
# Eval judge, standing in for HERB's gpt-4o judge (D035).
LORE_JUDGE_MODEL=claude-haiku-5-5
LORE_JUDGE_EFFORT=low
LORE_DAILY_SPEND_CAP_USD=2
# Org mode (D124): answers may use at most this much of the daily cap (default: half of it), so
# reading new items always keeps the rest; and each signed-in person's answers at most
# LORE_PERSON_SPEND_CAP_USD a day (~70 questions at Haiku 5.5's measured ~$0.0035 each).
# The demo and the eval keep one shared cap.
# LORE_ANSWER_SPEND_CAP_USD=1
LORE_PERSON_SPEND_CAP_USD=0.25
# Optional: a YAML of {model: [input, output, cache write, cache read]} USD per million tokens
# that overrides or adds to llm.PRICES (a new model or a price change needs no code change).
# LORE_PRICES_FILE=/app/data/prices.yaml

# Optional LiteLLM provider (D091; experimental, never run against a live model). Default
# "anthropic" is unchanged. For "litellm" install it (`uv pip install --python backend/.venv
# litellm`) and name a LiteLLM model per role (e.g. openai/gpt-4o-mini). Spend is still capped.
LORE_LLM_PROVIDER=anthropic
LORE_LITELLM_MODEL_EXTRACT=
LORE_LITELLM_MODEL_ANSWER=
LORE_LITELLM_MODEL_JUDGE=

# --- Public deployment guards (D081) ---
# On a public URL, set LORE_LLM_CACHE_ONLY=1: the API replays answers already in the cache (the
# demo questions, warmed beforehand) and never calls the API for a new one, so strangers or
# agent swarms can't spend the key. Also consider LORE_MCP_ASK=0 there.
LORE_LLM_CACHE_ONLY=0
LORE_ASK_PER_IP_PER_DAY=60
LORE_ASK_GLOBAL_PER_MINUTE=30
LORE_ASK_CONCURRENCY=4
LORE_REQUESTS_PER_IP_PER_MINUTE=300
# The per-IP limits count anonymous visitors (the demo). Signed-in people (org mode) have limits
# of their own, so a team behind one office address or one proxy doesn't share one (D124).
LORE_ASK_PER_PERSON_PER_MINUTE=6
LORE_ASK_PER_PERSON_PER_DAY=200
LORE_REQUESTS_PER_PERSON_PER_MINUTE=600
# Behind a reverse proxy (Caddy, nginx), uvicorn must trust its X-Forwarded-For, or every
# anonymous visitor shares the proxy's address and one budget (uvicorn reads this name). In
# Docker the API sees the Docker network's gateway, not the proxy's own address; since
# docker-compose.yml publishes the port on 127.0.0.1 only, "*" is safe there. Never use "*"
# when the port is reachable from other machines: anyone could then claim any address.
# FORWARDED_ALLOW_IPS=*

# --- Logs and metrics (22.4) ---
# JSON log lines on stderr (`docker compose logs`); `text` for people reading a terminal.
LORE_LOG_FORMAT=json
# /metrics (Prometheus text) answers admins; a scraper sends this as `Authorization: Bearer`.
# LORE_METRICS_TOKEN=

# --- Embeddings (local model, no key) ---
LORE_EMBED_MODEL=BAAI/bge-small-en-v1.5
LORE_EMBED_DIM=384

# --- Evaluation (optional) ---
# Only to run HERB's evaluate.py with its default OpenAI judge unchanged (Phase 5).
# OPENAI_API_KEY=

# --- MCP server (Phase 17.1) ---
# 1 = the MCP server also offers `ask` (the full agent, ~$0.003 a call, under the spend cap).
LORE_MCP_ASK=1

# --- Connectors (setup in backend/app/connectors/README.md). Sandboxes hold labeled synthetic data only. ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=
NOTION_TOKEN=
NOTION_PAGE_ID=
# Optional webhooks (D132): a change in GitHub or Jira wakes the worker at once instead of at the
# next poll. Point the tool at https://<your Yaan>/hooks/github or /hooks/jira with this secret.
GITHUB_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=

# --- Experimental connectors (NOT run against live APIs; backend/app/connectors/README.md). Each is off
# unless all of its required settings are set. Google and Zoom take an access token you already
# hold: the OAuth flow that obtains and refreshes it is not built.
LINEAR_API_KEY=
LINEAR_TEAM=
GITLAB_TOKEN=
GITLAB_PROJECT=
GITLAB_BASE_URL=              # optional; default https://gitlab.com
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_ID=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GMAIL_ACCESS_TOKEN=
GMAIL_LABEL=
GOOGLE_MEET_ACCESS_TOKEN=
GOOGLE_MEET_SPACE=
ZOOM_ACCESS_TOKEN=
ZOOM_USER_ID=                 # optional; default "me"
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
