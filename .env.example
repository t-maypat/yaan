# Copy to .env (never commit .env). Read by docker compose and by backend/app/config.py.

# --- FalkorDB ---
# Pinned image tag (docs/decisions.md A8, D009). docker compose refuses to start while this is empty.
# 6.x = Rust engine (digest in decisions.md). Fallback: v4.22.0 = C engine (4.x tags carry a "v").
FALKORDB_TAG=6.0.1
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
LORE_GRAPH=lore_herb
LORE_DEMO_GRAPH=lore_demo
# The graph the API serves (Ask, Inbox, live demo); `lore demo reset` creates it.
LORE_API_GRAPH=lore_demo
# Optional: enables POST /ingest/artifact (send it in the X-Lore-Secret header).
LORE_INGEST_SECRET=
QUERY_TIMEOUT_MS=2000
# Redis ACL users (Phase 1.4, D018). docker compose creates them at start; app/db.py logs in with them.
# The placeholders work for a local run (ports are bound to 127.0.0.1). Replace them before any
# deployment, e.g. with: python -c "import secrets; print(secrets.token_hex(16))"
# Letters, digits and dashes only: the image's start script splits these on spaces and globs.
# The Browser (http://localhost:3000) logs in as user "default" with the admin password.
FALKORDB_ADMIN_PASSWORD=lore-admin-local
FALKORDB_WRITER_USER=lore_writer
FALKORDB_WRITER_PASSWORD=lore-writer-local
FALKORDB_READER_USER=lore_reader
FALKORDB_READER_PASSWORD=lore-reader-local

# --- LLM (Anthropic) ---
# Needed for answers (Phase 4+) and extraction (Phase 7). Rebuilding the graph from a seed needs no key.
# Prepaid credits with auto-reload off are a hard cap; llm.py also refuses any call that could take
# today's spend over LORE_DAILY_SPEND_CAP_USD (D033). Check the key with: lore llm-check
ANTHROPIC_API_KEY=
LORE_EXTRACT_MODEL=claude-haiku-5-5
LORE_ANSWER_MODEL=claude-haiku-5-5
LORE_EXTRACT_EFFORT=low
LORE_ANSWER_EFFORT=medium
# Eval judge, standing in for HERB's gpt-4o judge (D035).
LORE_JUDGE_MODEL=claude-haiku-5-5
LORE_JUDGE_EFFORT=low
LORE_DAILY_SPEND_CAP_USD=2

# Optional LiteLLM provider (D091; experimental, never run against a live model). Default
# "anthropic" is unchanged. For "litellm" install the extra (`uv sync --project backend --extra
# litellm`) and name a LiteLLM model per role (e.g. openai/gpt-4o-mini). Spend is still capped.
LORE_LLM_PROVIDER=anthropic
LORE_LITELLM_MODEL_EXTRACT=
LORE_LITELLM_MODEL_ANSWER=
LORE_LITELLM_MODEL_JUDGE=

# --- Public deployment guards (D081) ---
# On a public URL, set LORE_LLM_CACHE_ONLY=1: the API replays answers already in the cache (the
# demo questions, warmed beforehand) and never calls the API for a new one, so strangers or
# agent swarms can't spend the key. Also consider LORE_MCP_ASK=0 there.
LORE_LLM_CACHE_ONLY=0
LORE_ASK_PER_IP_PER_DAY=60
LORE_ASK_GLOBAL_PER_MINUTE=30
LORE_ASK_CONCURRENCY=4
LORE_REQUESTS_PER_IP_PER_MINUTE=300
# Behind a reverse proxy (Caddy, nginx), uvicorn must trust its X-Forwarded-For, or every visitor
# shares the proxy's address and one budget. Set the proxy's IP here (uvicorn reads this name).
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Embeddings (local model, no key) ---
LORE_EMBED_MODEL=BAAI/bge-small-en-v1.5
LORE_EMBED_DIM=384

# --- Evaluation (optional) ---
# Only to run HERB's evaluate.py with its default OpenAI judge unchanged (Phase 5).
# OPENAI_API_KEY=

# --- MCP server (Phase 17.1) ---
# 1 = the MCP server also offers `ask` (the full agent, ~$0.003 a call, under the spend cap).
LORE_MCP_ASK=1

# --- Connectors (Phase 17; setup in docs/connectors.md). Sandboxes hold labeled synthetic data only. ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=
NOTION_TOKEN=
NOTION_PAGE_ID=

# --- Experimental connectors (D090; NOT run against live APIs; docs/connectors.md). Each is off
# unless all of its required settings are set. Google and Zoom take an access token you already
# hold: the OAuth flow that obtains and refreshes it is not built.
LINEAR_API_KEY=
LINEAR_TEAM=
GITLAB_TOKEN=
GITLAB_PROJECT=
GITLAB_BASE_URL=              # optional; default https://gitlab.com
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_ID=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GMAIL_ACCESS_TOKEN=
GMAIL_LABEL=
GOOGLE_MEET_ACCESS_TOKEN=
GOOGLE_MEET_SPACE=
ZOOM_ACCESS_TOKEN=
ZOOM_USER_ID=                 # optional; default "me"
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
