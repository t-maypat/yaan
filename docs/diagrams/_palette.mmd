%% Shared draw.io palette, appended to every diagram by scripts/render_diagrams.py.
%% Tag nodes with :::code, :::store, :::human, :::guard, :::ext or :::file.
classDef code fill:#dae8fc,stroke:#6c8ebf,color:#1a1a1a
classDef store fill:#d5e8d4,stroke:#82b366,color:#1a1a1a
classDef human fill:#fff2cc,stroke:#d6b656,color:#1a1a1a
classDef guard fill:#f8cecc,stroke:#b85450,color:#1a1a1a
classDef ext fill:#e1d5e7,stroke:#9673a6,color:#1a1a1a
classDef file fill:#f5f5f5,stroke:#666666,color:#1a1a1a
