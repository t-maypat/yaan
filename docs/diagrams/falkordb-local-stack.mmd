%% What runs where when FalkorDB is up locally (Phase 1).
flowchart LR
  subgraph PC["Your PC · Windows 11"]
    direction LR
    APP["Lore backend<br/>Python + falkordb client"]:::code
    WEB(["Your browser"]):::human
    subgraph DOCKER["Docker Desktop · a small Linux VM"]
      direction TB
      subgraph CT["Container lore-falkordb-1 · image falkordb/falkordb:6.0.1"]
        direction TB
        RS["Redis server 8.10.2<br/>port 6379"]:::code
        GM["graph module<br/>FalkorDB 6.0.1 · Rust engine"]:::code
        BR["FalkorDB Browser<br/>port 3000"]:::ext
        CLI["redis-cli<br/>via docker compose exec"]:::file
      end
      VOL[("Volume falkordb-data<br/>/var/lib/falkordb/data")]:::store
    end
  end
  APP -- "127.0.0.1:6379" --> RS
  WEB -- "127.0.0.1:3000" --> BR
  BR --> RS
  CLI --> RS
  RS --- GM
  RS -- "snapshot within 60 s<br/>+ final save on stop" --> VOL
