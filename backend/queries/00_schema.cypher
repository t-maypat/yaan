// 00_schema.cypher — indexes for one graph; `lore schema` runs it one line per call, then checks the result (CONTEXT §9.14; verified on 6.0.1 in Phase 1.5)
CREATE INDEX FOR (p:Person) ON (p.id)
CREATE INDEX FOR (t:Team) ON (t.id)
CREATE INDEX FOR (p:Product) ON (p.id)
CREATE INDEX FOR (c:Customer) ON (c.id)
CREATE INDEX FOR (c:Company) ON (c.id)
CREATE INDEX FOR (o:Org) ON (o.id)
CREATE INDEX FOR (c:Channel) ON (c.id)
CREATE INDEX FOR (a:Artifact) ON (a.id)
CREATE INDEX FOR (a:Artifact) ON (a.ts_ms)
CREATE INDEX FOR (c:Chunk) ON (c.id)
CREATE INDEX FOR (f:Feature) ON (f.id)
CREATE INDEX FOR (i:Issue) ON (i.id)
CREATE INDEX FOR (a:Area) ON (a.id)
CREATE INDEX FOR (c:Community) ON (c.id)
CREATE INDEX FOR (d:Decision) ON (d.id)
CREATE INDEX FOR (d:Decision) ON (d.topic)
CREATE INDEX FOR (c:Claim) ON (c.topic)
CREATE INDEX FOR (c:Claim) ON (c.id)
CREATE INDEX FOR (c:Claim) ON (c.product_id)
CREATE INDEX FOR (i:Issue) ON (i.product_id)
CREATE INDEX FOR (d:Decision) ON (d.product_id)
CREATE INDEX FOR (e:Event) ON (e.id)
CREATE INDEX FOR (e:Event) ON (e.product_id)
CREATE INDEX FOR (e:Event) ON (e.artifact_id)
CREATE INDEX FOR (a:Alert) ON (a.id)
CREATE INDEX FOR (a:Action) ON (a.id)
CREATE FULLTEXT INDEX FOR (c:Chunk) ON (c.text)
CREATE FULLTEXT INDEX FOR (e:Entity) ON (e.name)
CREATE VECTOR INDEX FOR (c:Chunk) ON (c.embedding) OPTIONS {dimension: 384, similarityFunction: 'cosine'}
