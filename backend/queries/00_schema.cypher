// 00_schema.cypher — indexes for one graph; `lore schema` runs it one line per call (draft from CONTEXT §9.14; verified in Phase 1)
CREATE INDEX FOR (p:Person) ON (p.id)
CREATE INDEX FOR (t:Team) ON (t.id)
CREATE INDEX FOR (p:Product) ON (p.id)
CREATE INDEX FOR (c:Customer) ON (c.id)
CREATE INDEX FOR (c:Company) ON (c.id)
CREATE INDEX FOR (a:Artifact) ON (a.id)
CREATE INDEX FOR (a:Artifact) ON (a.ts_ms)
CREATE INDEX FOR (c:Chunk) ON (c.id)
CREATE INDEX FOR (f:Feature) ON (f.id)
CREATE INDEX FOR (i:Issue) ON (i.id)
CREATE INDEX FOR (d:Decision) ON (d.id)
CREATE INDEX FOR (d:Decision) ON (d.topic)
CREATE INDEX FOR (c:Claim) ON (c.topic)
CALL db.idx.fulltext.createNodeIndex('Chunk', 'text')
CALL db.idx.fulltext.createNodeIndex('Entity', 'name')
CREATE VECTOR INDEX FOR (c:Chunk) ON (c.embedding) OPTIONS {dimension: 384, similarityFunction: 'cosine'}
