// sentinel_company.cypher — invented fixture for the Sentinel (Phase 11): an issue reported, resolved by a PR (two reviews by one reviewer, one by another) and reopened by the customer; two more issues on the same component (one open, one resolved) and one elsewhere; two teams on the product; a PR-action decision; a CAUSED chain four hops long
CREATE
  (widget:Product:Entity {id: 'Widget', name: 'Widget', current_name: 'Widget', aliases: []}),
  (bo:Person:Entity {id: 'eid_b2', name: 'Bo Chen', role: 'Engineering Lead'}),
  (cy:Person:Entity {id: 'eid_c3', name: 'Cy Diaz', role: 'Software Engineer'}),
  (di:Person:Entity {id: 'eid_d4', name: 'Di Park', role: 'QA Specialist'}),
  (dee:Customer:Entity {id: 'CUST-0001', name: 'Dee Fox', role: 'CEO'}),
  (wave:Company:Entity {id: 'co:blue-wave', name: 'Blue Wave'}),
  (dee)-[:WORKS_AT]->(wave),
  (t1:Team {id: 'team:eid_b2', name: 'Bo Chen\'s team'}), (t2:Team {id: 'team:eid_d4', name: 'Di Park\'s team'}),
  (t1)-[:WORKS_ON {stage: 'dev', artifacts: 5}]->(widget), (t1)-[:WORKS_ON {stage: 'support', artifacts: 3}]->(widget),
  (t2)-[:WORKS_ON {stage: 'support', artifacts: 2}]->(widget),
  (r1:Artifact:Message {id: 'msg:r1', kind: 'message', text: 'Issue \'Slow export\' in the Export Module hurts CUST-0001. @eid_c3 please take it.', ts_ms: 1000, ts_iso: '2026-05-01T00:00:01Z', product_id: 'Widget'}),
  (r2:Artifact:Message {id: 'msg:r2', kind: 'message', text: 'Slow export is fixed, see PR 1.', ts_ms: 3000, ts_iso: '2026-05-01T00:00:03Z', product_id: 'Widget'}),
  (r3:Artifact:Message {id: 'msg:r3', kind: 'message', text: 'CUST-0001 has reopened Slow export.', ts_ms: 5000, ts_iso: '2026-05-01T00:00:05Z', product_id: 'Widget'}),
  (bo)-[:AUTHORED]->(r1), (cy)-[:AUTHORED]->(r2), (bo)-[:AUTHORED]->(r3),
  (r1)-[:IN_PRODUCT]->(widget), (r2)-[:IN_PRODUCT]->(widget), (r3)-[:IN_PRODUCT]->(widget),
  (p1:Artifact:PR {id: 'pr:w1', kind: 'pr', title: 'Speed up export', url: 'https://github.com/salesforce/Widget/pull/1', number: 1, current_status: 'merged', ts_ms: 2000, ts_iso: '2026-05-01T00:00:02Z', product_id: 'Widget'}),
  (p1)-[:IN_PRODUCT]->(widget), (cy)-[:AUTHORED]->(p1),
  (bo)-[:REVIEWED {state: 'CHANGES_REQUESTED', ts_ms: 2100, comment: 'Add a test.'}]->(p1),
  (bo)-[:REVIEWED {state: 'APPROVED', ts_ms: 2300, comment: 'LGTM now.'}]->(p1),
  (di)-[:REVIEWED {state: 'APPROVED', ts_ms: 2200, comment: 'Works for me.'}]->(p1),
  (iss:Issue:Entity {id: 'iss:Widget:a1', title: 'Slow export', name: 'Slow export', product_id: 'Widget', component: 'Export Module', current_status: 'reopened', reported_ms: 1000, reported_iso: '2026-05-01T00:00:01Z'}),
  (iss2:Issue:Entity {id: 'iss:Widget:b2', title: 'Export drops rows', name: 'Export drops rows', product_id: 'Widget', component: 'Export Module', current_status: 'reported', reported_ms: 1500, reported_iso: '2026-05-01T00:00:01Z'}),
  (iss3:Issue:Entity {id: 'iss:Widget:c3', title: 'Export timeout', name: 'Export timeout', product_id: 'Widget', component: 'Export Module', current_status: 'resolved', reported_ms: 1200, reported_iso: '2026-05-01T00:00:01Z'}),
  (iss4:Issue:Entity {id: 'iss:Widget:d4', title: 'Login flicker', name: 'Login flicker', product_id: 'Widget', component: 'Auth Module', current_status: 'reported', reported_ms: 1300, reported_iso: '2026-05-01T00:00:01Z'}),
  (iss)-[:IN_PRODUCT]->(widget), (iss2)-[:IN_PRODUCT]->(widget), (iss3)-[:IN_PRODUCT]->(widget), (iss4)-[:IN_PRODUCT]->(widget),
  (iss)-[:REPORTED_BY]->(dee), (iss)-[:ASSIGNED_TO {from_ms: 1000}]->(cy), (p1)-[:FIXES]->(iss),
  (dR:Decision {id: 'dec:iss:Widget:a1/status:1000', topic: 'iss:Widget:a1/status', kind: 'issue_status', value: 'reported', valid_from_ms: 1000, valid_to_ms: 3000, status: 'superseded', origin: 'extracted'}),
  (dF:Decision {id: 'dec:iss:Widget:a1/status:3000', topic: 'iss:Widget:a1/status', kind: 'issue_status', value: 'resolved', valid_from_ms: 3000, valid_to_ms: 5000, status: 'superseded', origin: 'extracted'}),
  (dO:Decision {id: 'dec:iss:Widget:a1/status:5000', topic: 'iss:Widget:a1/status', kind: 'issue_status', value: 'reopened', valid_from_ms: 5000, status: 'active', origin: 'extracted'}),
  (dR)-[:AFFECTS]->(iss), (dF)-[:AFFECTS]->(iss), (dO)-[:AFFECTS]->(iss),
  (dF)-[:SUPERSEDES]->(dR), (dO)-[:SUPERSEDES]->(dF),
  (dR)-[:EVIDENCED_BY {field: 'text', quote: 'Issue \'Slow export\' in the Export Module'}]->(r1),
  (dF)-[:EVIDENCED_BY {field: 'text', quote: 'Slow export is fixed'}]->(r2),
  (dO)-[:EVIDENCED_BY {field: 'text', quote: 'CUST-0001 has reopened Slow export.'}]->(r3),
  (dR)-[:DECIDED_BY]->(bo), (dF)-[:DECIDED_BY]->(cy), (dO)-[:DECIDED_BY]->(bo),
  (dA:Decision {id: 'dec:pr:w1/action:2500', topic: 'pr:w1/action', kind: 'pr_action', value: 'to_merge', valid_from_ms: 2500, status: 'active', origin: 'extracted'}),
  (dA)-[:AFFECTS]->(p1),
  (c1:Decision {id: 'dec:c1', statement: 'one hop', value: 'x'}), (c2:Decision {id: 'dec:c2', statement: 'two hops', value: 'x'}),
  (c3:Decision {id: 'dec:c3', statement: 'three hops', value: 'x'}), (c4:Decision {id: 'dec:c4', statement: 'four hops', value: 'x'}),
  (dO)-[:CAUSED]->(c1), (c1)-[:CAUSED]->(c2), (c2)-[:CAUSED]->(c3), (c3)-[:CAUSED]->(c4)
